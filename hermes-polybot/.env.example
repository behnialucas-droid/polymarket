# Hermes Polybot — Environment Variables
# Copy this file to .env for local development.
# NEVER commit .env — it is in .gitignore.
# NEVER put real values in this file — it is committed to git.

# --- Required: Database ---
# Supabase transaction pooler (port 6543, pgbouncer=true). Used by the automation.
DATABASE_URL=

# Supabase direct connection (port 5432). Used only for migrations.
DIRECT_URL=

# --- Required: Telegram ---
# Bot token from @BotFather. One bot only — no fallback.
TELEGRAM_BOT_TOKEN=

# Chat ID to deliver hourly reports to.
TELEGRAM_CHAT_ID=

# --- Required: GitHub Actions self-dispatch ---
# Fine-grained PAT with Actions: read+write on this repo only.
# Used by rescan.yml to dispatch the next chunk. Default GITHUB_TOKEN cannot do this.
WORKFLOW_DISPATCH_TOKEN=

# --- Optional: Tuning ---
# Data source: 'live' (public Polymarket APIs) or 'demo' (seed data)
DATA_SOURCE=live

# Max wallets pulled from leaderboard per scan
LEADERBOARD_LIMIT=500

# Max wallets profiled per cycle (tracked wallets only after Phase 3)
WALLET_SCAN_LIMIT=20

# Minimum hours to resolution for a market to be considered for paper copying
MIN_HOURS_TO_RESOLUTION=4

# Minimum ms between API calls per host (rate limiter floor)
PM_MIN_INTERVAL_MS=200

# Max concurrent in-flight API requests per host
PM_MAX_CONCURRENT=5

# Timezone for Telegram report timestamps (e.g. Asia/Tehran, America/New_York)
REPORT_TZ=UTC

# Trigger a rescan check on every hourly run?
RESCAN_ENABLED=true

# Days between full 30-day rescans
RESCAN_INTERVAL_DAYS=30

# Rescan chunk size (wallets per chunk)
RESCAN_CHUNK_SIZE=250

# Hard stop: abandon generation if more than this many chunks dispatched
RESCAN_MAX_CHUNKS=20

# --- DO NOT ADD REAL VALUES ABOVE THIS LINE ---
# Use GitHub Actions secrets for production credentials.
# See docs/00-ROTATE-SECRETS.md for the rotation runbook.
