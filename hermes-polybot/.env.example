# Data source: 'demo' (labeled synthetic data) or 'live' (public Polymarket APIs)
DATA_SOURCE=demo

# SQLite file location (defaults to ./data/polybot.db)
# DATABASE_PATH=./data/polybot.db

# Optional Telegram for end-of-day reports. NEVER commit real values.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Scan sizes
# LEADERBOARD_LIMIT=500
# WALLET_SCAN_LIMIT=50

# NOTE: This app never asks for, stores, or uses private keys. Paper trading only.
